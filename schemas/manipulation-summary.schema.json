{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concise manipulation evidence view v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "reportId",
    "image",
    "status",
    "decision",
    "screening",
    "aigc",
    "localization",
    "regions",
    "evidence",
    "disagreements",
    "limitations",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportType": { "const": "manipulation_summary" },
    "reportId": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "sha256",
        "width",
        "height",
        "original",
        "display",
        "coordinateSpace"
      ],
      "properties": {
        "imageId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha256": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "original": { "type": "string" },
        "display": { "type": "string" },
        "coordinateSpace": { "const": "display_image_pixels" }
      }
    },
    "status": { "enum": ["completed", "partial", "failed"] },
    "decision": { "const": "inconclusive" },
    "confidencePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["reliability", "comparableAcrossModels"],
      "properties": { "reliability": { "const": "not_calibrated" }, "comparableAcrossModels": { "const": false } }
    },
    "evidenceLinks": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relation", "question", "models", "evidenceIds", "regionIds", "description"],
        "properties": {
          "relation": { "enum": ["corroborates", "different_tasks", "different_findings"] },
          "question": { "enum": ["local_editing", "ai_generation", "image_anomaly"] },
          "strength": { "enum": ["strong", "supporting"] },
          "models": { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true },
          "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "regionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contentType": { "type": ["string", "null"], "enum": ["photo", "document", "unsure", null] },
    "routing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "status", "decision"],
      "properties": {
        "mode": { "enum": ["auto", "manual"] },
        "status": { "enum": ["completed", "failed", "skipped"] },
        "decision": { "type": ["string", "null"], "enum": ["photo", "document", "unsure", null] },
        "scores": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["photo", "document"],
          "properties": {
            "photo": { "type": "number", "minimum": 0, "maximum": 1 },
            "document": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "margin": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "marginThreshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "status"],
      "properties": {
        "confidence": { "$ref": "#/$defs/modelSupport" },
        "model": { "$ref": "#/$defs/model" },
        "status": { "$ref": "#/$defs/status" },
        "decision": { "enum": ["fake", "real"] },
        "decisionConfidence": { "$ref": "#/$defs/decisionConfidence" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibrated": { "const": false },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "aigc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "status"],
      "properties": {
        "confidence": { "$ref": "#/$defs/modelSupport" },
        "model": { "$ref": "#/$defs/model" },
        "status": { "$ref": "#/$defs/status" },
        "decision": { "enum": ["ai_generated", "non_ai", "inconclusive"] },
        "decisionConfidence": { "$ref": "#/$defs/decisionConfidence" },
        "zScore": { "type": "number" },
        "threshold": { "type": "number" },
        "attributedSource": { "type": ["string", "null"] },
        "attributionScore": { "type": ["number", "null"] },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "localization": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "status"],
        "properties": {
          "confidence": { "$ref": "#/$defs/modelSupport" },
          "model": { "$ref": "#/$defs/model" },
          "status": { "$ref": "#/$defs/status" },
          "regionCount": { "type": "integer", "minimum": 0 },
          "listedRegionCount": { "type": "integer", "minimum": 0 },
          "areaFraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "mask": { "type": ["string", "null"] },
          "heatmap": { "type": ["string", "null"] },
          "evidenceIds": { "$ref": "#/$defs/strings" },
          "error": { "$ref": "#/$defs/error" }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regionId", "model", "bboxXYWH", "crop"],
        "properties": {
          "confidence": { "$ref": "#/$defs/modelSupport" },
          "regionId": { "type": "string" },
          "model": { "enum": ["rita", "rise"] },
          "bboxXYWH": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 }
          },
          "areaPixels": { "type": "integer", "minimum": 0 },
          "crop": { "type": ["string", "null"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "model", "description", "artifacts"],
        "properties": {
          "evidenceId": { "type": "string" },
          "model": { "enum": ["aigc", "sica", "rita", "rise"] },
          "description": { "type": "string" },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disagreements": { "$ref": "#/$defs/strings" },
    "limitations": { "$ref": "#/$defs/strings" },
    "audit": { "const": "bundle.json" }
  },
  "$defs": {
    "modelSupport": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "description", "target", "source", "calibrated", "comparableAcrossModels"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "target": { "enum": ["general_image_classification", "ai_generation_classification", "marked_region_pixels"] },
        "description": { "type": "string", "minLength": 1 },
        "source": { "enum": ["model_sigmoid", "threshold_distance", "mean_tamper_response"] },
        "calibrated": { "const": false },
        "comparableAcrossModels": { "const": false }
      }
    },
    "decisionConfidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "source", "distance", "normalization", "calibrated", "comparableAcrossModels"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "const": "threshold_distance" },
        "distance": { "type": "number", "minimum": 0 },
        "normalization": { "enum": ["class_side_range", "distance_over_distance_plus_one"] },
        "calibrated": { "const": false },
        "comparableAcrossModels": { "const": false }
      }
    },
    "status": { "enum": ["completed", "failed", "not_run"] },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "enum": ["aigc", "sica", "rita", "rise"] },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "checkpointSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
