{
  "name": "image-authenticity-app",
  "version": "0.3.0",
  "private": true,
  "description": "通用鉴伪系统",
  "main": "./out/main/index.js",
  "author": "SRDP",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run runtime:ensure",
    "dev": "electron-vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples:prepare": "node scripts/prepare-stage1-materials.mjs",
    "examples:validate": "node scripts/validate-stage1-materials.mjs",
    "rita:setup": "node scripts/setup-rita-source.mjs",
    "rita:infer": "node scripts/run-rita.mjs",
    "sica:setup": "node scripts/setup-sica-source.mjs",
    "sica:infer": "node scripts/run-sica.mjs",
    "rise:setup": "node scripts/setup-rise-source.mjs",
    "rise:infer": "node scripts/run-rise.mjs",
    "aigc:setup": "node scripts/setup-fsd.mjs",
    "smoke:rise": "npm run build && node tests/rise-smoke.mjs",
    "test:workflow": "node tests/workflow-unit.mjs",
    "test:image-viewport": "node tests/image-viewport.mjs",
    "test:workbench": "node tests/workbench-interaction.mjs",
    "test:lifecycle": "node --import tsx tests/session-lifecycle.mjs && node --import tsx tests/python-worker.mjs",
    "test:protocol": "node tests/protocol-tests.mjs",
    "test:confidence": "node tests/decision-confidence.mjs",
    "test:explanation": "node tests/user-explanation.mjs",
    "test:source-conclusion": "node --import tsx tests/source-conclusion.mjs",
    "test:evidence-links": "node --import tsx tests/evidence-links.mjs",
    "vlm:evaluate": "node --import tsx scripts/evaluate-vlm.mjs",
    "smoke:conversation": "npm run build && node tests/conversation-smoke.mjs",
    "test:watermark": "node tests/watermark-metadata.mjs",
    "test:c2pa": "node tests/provenance-c2pa.mjs",
    "test:provenance-metadata": "node tests/provenance-metadata.mjs",
    "test:provenance-reader": "node tests/provenance-reader.mjs",
    "test:provenance-input": "node --import tsx tests/provenance-input.mjs",
    "test:region-text": "node --import tsx tests/region-text.mjs",
    "provenance:setup": "node scripts/setup-provenance.mjs",
    "explanation:setup": "node scripts/setup-explanation-local.mjs",
    "report:validate": "node scripts/validate-manipulation-summary.mjs",
    "smoke:workflow": "npm run build && node tests/workflow-smoke.mjs",
    "smoke:sica": "npm run build && node tests/sica-smoke.mjs",
    "smoke:rita": "npm run build && node tests/rita-smoke.mjs",
    "smoke:rita:real": "npm run build && node tests/rita-real-smoke.mjs",
    "prestart": "npm run runtime:ensure",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "npm run build && node tests/smoke.mjs",
    "smoke:dev": "npm run build && node tests/smoke.mjs --dev",
    "smoke:startup": "node tests/startup.mjs",
    "smoke:packaged": "npm run package:dir && node tests/smoke.mjs --packaged",
    "smoke:installer": "node tests/installer-smoke.mjs",
    "runtime:ensure": "node scripts/ensure-electron.mjs",
    "package:dir": "npm run build && npm run runtime:ensure && node scripts/package-windows.mjs --dir",
    "package:win": "node scripts/build-icon.mjs && npm run build && npm run runtime:ensure && node scripts/package-windows.mjs",
    "package:research": "npm run package:win && node scripts/package-research.mjs",
    "package:distributions": "npm run package:win && python scripts/package-distributions.py"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "cn.srdp.desktop",
    "productName": "通用鉴伪系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": ["node_modules/sharp/**/*", "node_modules/@img/**/*"],
    "extraResources": [
      { "from": "backend", "to": "backend", "filter": ["**/*.py", "**/*.json", "**/*.txt", "!**/__pycache__/**", "!**/test_*.py", "!**/evaluate.py"] },
      { "from": "config", "to": "config-templates", "filter": ["*.example.json"] },
      { "from": "docs/INSTALLATION.md", "to": "INSTALLATION.md" }
      ,{ "from": "build/icon.ico", "to": "icon.ico" }
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "executableName": "SRDP",
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "SRDP-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "通用鉴伪系统",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}
